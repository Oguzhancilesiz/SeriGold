@{
    ViewData["Title"] = "Döviz Kurları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        /* sayfaya özel ufaklar */
        .box {
            border: 1px solid var(--sg-border);
            border-radius: 14px
        }

        .smallmuted {
            color: var(--sg-muted-strong);
            font-size: .92rem
        }

        .price {
            font-variant-numeric: tabular-nums
        }
        /* --- global koruma --- */
        html, body {
            width: 100%;
            max-width: 100%;
            overflow-x: clip;
        }
        @@supports not (overflow-x: clip) {
            html, body

        {
            overflow-x: hidden;
        }

        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        img, svg, video, canvas {
            max-width: 100%;
            height: auto;
        }

        .sg-card, .box {
            max-width: 100%;
        }

        .ticker, .ticker-wrap {
            overflow: hidden;
        }

        .ticker__track {
            will-change: transform;
        }

        /* flex içindeki arama grubunun genişleyebilmesi için */
        #fxCard .sg-input {
            min-width: 0;
        }

            #fxCard .sg-input .form-control {
                min-width: 0;
                flex: 1 1 150px;
            }

        /* mobil tablolar */
        @@media (max-width:576px) {
            table .market-table

        {
            table-layout: fixed;
            width: 100%;
        }
        /* 4. kolon (Değişim) xs'de gizli, Satış hücresine inline değişim zaten ekli */
        .market-table th:nth-child(4),
        .market-table td:nth-child(4) {
            display: none;
        }

        .inl-chg {
            margin-left: .25rem;
            white-space: nowrap;
            font-size: .86rem;
        }

        /* 3D tilt ve aşırı parıltı mobilde taşma yaratmasın */
        .tilt, .sg-card.tilt {
            transform: none !important;
        }

        }
        @@media (max-width:575.98px) {
            .sg-left

        {
            display: none !important;
        }
        /* sol menüyü gizle */
        .sg-right {
            justify-self: end;
            margin-left: auto;
        }

        .sg-brand {
            justify-self: center;
        }

        }
    </style>
}

<div id="dovizApp" class="container-xxl py-3">
    <!-- Üst bilgi + saat -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div class="toggle-group compact" role="tablist" aria-label="Döviz">
            <button type="button" class="toggle" :class="{active: fxTab==='TRY'}" @@click="fxTab='TRY'">TRY</button>
            <button type="button" class="toggle" :class="{active: fxTab==='USD'}" @@click="fxTab='USD'">USD</button>
            <button type="button" class="toggle" :class="{active: fxTab==='EUR'}" @@click="fxTab='EUR'">EUR</button>
        </div>
    </div> <!-- ← EKLENDİ -->

    <!-- Ticker -->
    <div class="ticker-wrap">
        <div class="ticker">
            <div class="ticker__track" aria-live="polite">
                <template v-if="topList.length">
                    <template v-for="(t,i) in tickerDoubled" :key="i">
                        <span class="ticker__item">
                            <span class="lbl">{{ t.label }}</span>
                            <span class="val price" :class="t.delta>=0?'rise':'drop'">{{ n(t.value, t.label) }}</span>
                            <i :class="t.delta>=0?'bi bi-caret-up-fill rise':'bi bi-caret-down-fill drop'"></i>
                            <small :class="t.delta>=0?'rise':'drop'">%{{ p(t.delta, t.label) }}</small>
                        </span>
                    </template>
                </template>
                <template v-else>
                    <span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>{{ loadMsg }}</span></span>
                    <span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>{{ nextLoadMsg }}</span></span>
                </template>
            </div>
        </div>
    </div>

    <!-- Çevirici -->
    <div class="sg-card box p-3 mb-3 reveal tilt">
        <div class="row g-2 align-items-end sg-input">
            <!-- Sol: Gönderilen -->
            <div class="col-12 col-md-5">
                <label class="form-label small text-muted">Gönderilen</label>
                <div class="input-group">
                    <input v-model.number="convAmt" type="number" inputmode="decimal" step="0.01" min="0" class="form-control form-control-lg" />
                    <select v-model="convPair" class="form-select form-select-lg">
                        <option v-for="p in pairs" :key="p" :value="p">{{ p }}</option>
                    </select>
                </div>
            </div>

            <!-- Orta: Yön değiştir -->
            <div class="col-12 col-md-2 d-flex justify-content-center">
                <button type="button" class="icon-btn w-100" @@click="convDir = !convDir" title="Yön değiştir" data-ripple>
                    <i class="bi bi-arrow-left-right"></i>
                </button>
            </div>

            <!-- Sağ: Alacağınız -->
            <div class="col-12 col-md-5">
                <label class="form-label small text-muted">Alacağınız</label>
                <div class="input-group">
                    <input :value="convResult==null?'—':n(convResult, convPairDisplay)" class="form-control form-control-lg" readonly />
                    <!-- hedef para birimi etiketi: her zaman görüntülenen çiftin sağ tarafı -->
                    <span class="input-group-text">{{ (convPairDisplay.split('/')[1] || '') }}</span>
                    <button type="button" class="btn btn-gold-outline" @@click="copyConv()" title="Sonucu kopyala" data-ripple>
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>

            <!-- Alt satır: fiyat modu + birim kur -->
            <div class="col-12 d-flex flex-wrap align-items-center gap-2 mt-1">
                <div class="toggle-group compact" role="group" aria-label="Fiyat modu">
                    <button type="button" class="toggle" :class="{active: convMode==='mid'}" @@click="convMode='mid'">Orta</button>
                    <button type="button" class="toggle" :class="{active: convMode==='bid'}" @@click="convMode='bid'">Alış</button>
                    <button type="button" class="toggle" :class="{active: convMode==='ask'}" @@click="convMode='ask'">Satış</button>
                </div>

                <span v-if="convUnitRate!=null" class="ms-auto smallmuted">
                    1 {{ convDir ? convPairSplit[1] : convPairSplit[0] }} ≈
                    <b class="price">{{ n(convUnitRate, convPairDisplay) }}</b>
                    {{ convDir ? convPairSplit[0] : convPairSplit[1] }}
                    <span class="text-subtle ms-2">({{ convModeLabel }})</span>
                </span>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- SOL: Altın & Metaller / Sarrafiye sekmeli -->
        <div class="col-lg-6">
            <div class="sg-card box p-3 h-100 reveal tilt">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="toggle-group" role="tablist" aria-label="Emtia">
                        <button type="button" class="toggle" :class="{active: activeTab==='metals'}" @@click="activeTab='metals'">Altın & Metaller</button>
                        <button type="button" class="toggle" :class="{active: activeTab==='mint'}" @@click="activeTab='mint'">Sarrafiye</button>
                    </div>
                    <span class="smallmuted" v-if="activeTab==='metals'">XAU, XAG, Platin, Paladyum + Gram/TL</span>
                    <span class="smallmuted" v-else>Yeni/Eski Çeyrek, Yarım, Tam, Ata, Gremse…</span>
                </div>

                <div class="table-responsive">
                        <table class="table table-sm market-table sg-table">
                            <thead>
                                <tr>
                                    <th class="sticky">Ürün</th>
                                    <th class="text-end sticky">Alış</th>
                                    <th class="text-end sticky">Satış</th>
                                    <th class="text-end sticky d-none d-sm-table-cell">Değişim</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-if="!tabRows.length && !all.length">
                                    <td colspan="4" class="text-center smallmuted">
                                        <span class="spinner-border spinner-border-sm me-2"></span> Yükleniyor…
                                    </td>
                                </tr>

                                <tr v-for="r in tabRows" :key="r.symbol">
                                    <td>
                                        <i :class="isFav(r.symbol)?'bi bi-star-fill text-warning':'bi bi-star'"
                                           @@click="toggleFav(r.symbol)"></i>
                                        <span class="ms-1">{{ fmtSym(r) }}</span>
                                    </td>

                                    <td class="text-end price" :class="pulseCls(r)">{{ n(r.bid, r.symbol) }}</td>

                                    <!-- Satış + inline % (xs) -->
                                    <td class="text-end price" :class="pulseCls(r)">
                                        {{ n(r.ask, r.symbol) }}
                                        <span class="inl-chg d-inline d-sm-none">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill drop':'bi bi-caret-up-fill rise'"></i>
                                            <small :class="dir(r)==='down'?'drop':'rise'">%{{ p(delta(r), r.symbol) }}</small>
                                        </span>
                                    </td>

                                    <!-- Değişim yalnız ≥sm -->
                                    <td class="text-end d-none d-sm-table-cell">
                                        <span :class="dir(r)==='down'?'drop':'rise'">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill':'bi bi-caret-up-fill'"></i>
                                            %{{ p(delta(r), r.symbol) }}
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                </div>
            </div>
        </div>

        <!-- SAĞ: Döviz TRY/USD/EUR sekmeli -->
        <div class="col-lg-6">
            <div id="fxCard" class="sg-card box p-3 h-100 reveal tilt" :class="{'dense': dense}">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="toggle-group compact" role="tablist" aria-label="Döviz">
                        <button type="button" class="toggle" :class="{active: fxTab==='TRY'}" @@click="fxTab='TRY'">TRY</button>
                        <button type="button" class="toggle" :class="{active: fxTab==='USD'}" @@click="fxTab='USD'">USD</button>
                        <button type="button" class="toggle" :class="{active: fxTab==='EUR'}" @@click="fxTab='EUR'">EUR</button>
                    </div>

                        <div class="d-flex align-items-center gap-2 sg-input flex-wrap flex-grow-1" style="min-width:260px">
                            <input v-model.trim="qFx" class="form-control form-control-sm flex-grow-1"
                                   placeholder="Ara: EUR/TRY, USD/JPY…" />
                            <label class="form-check smallmuted mb-0">
                                <input type="checkbox" v-model="fxFavOnly" class="form-check-input me-1">Sadece ★
                            </label>
                        </div>
                    </div>

                <div class="table-responsive" style="max-height:460px">
                        <table class="table table-sm market-table sg-table">
                            <thead>
                                <tr>
                                    <th class="sticky">Parite</th>
                                    <th class="text-end sticky">Alış</th>
                                    <th class="text-end sticky">Satış</th>
                                    <th class="text-end sticky d-none d-sm-table-cell">Değişim</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-if="!fxTabRows.length && !all.length">
                                    <td colspan="4" class="text-center smallmuted">
                                        <span class="spinner-border spinner-border-sm me-2"></span> Yükleniyor…
                                    </td>
                                </tr>

                                <tr v-for="r in fxTabRows" :key="r.symbol">
                                    <td>
                                        <i :class="isFav(r.symbol)?'bi bi-star-fill text-warning':'bi bi-star'"
                                           title="Favori" @@click="toggleFav(r.symbol)"></i>
                                        <span class="ms-1">{{ r.symbol }}</span>
                                    </td>

                                    <td class="text-end price" :class="pulseCls(r)">{{ n(r.bid, r.symbol) }}</td>

                                    <!-- Satış + inline % (xs) -->
                                    <td class="text-end price" :class="pulseCls(r)">
                                        {{ n(r.ask, r.symbol) }}
                                        <span class="inl-chg d-inline d-sm-none">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill drop':'bi bi-caret-up-fill rise'"></i>
                                            <small :class="dir(r)==='down'?'drop':'rise'">%{{ p(delta(r), r.symbol) }}</small>
                                        </span>
                                    </td>

                                    <!-- Değişim yalnız ≥sm -->
                                    <td class="text-end d-none d-sm-table-cell">
                                        <span class="badge-soft" :class="dir(r)==='down'?'drop':'rise'">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill':'bi bi-caret-up-fill'"></i>
                                            %{{ p(delta(r), r.symbol) }}
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                </div>

                <div class="d-flex justify-content-between smallmuted mt-1">
                    <span>Gösterilen: <b>{{ fxTabRows.length }}</b></span>
                    <span>Tab: <b>{{ fxTab }}</b></span>
                </div>
            </div>
        </div>
    </div>
</div>

