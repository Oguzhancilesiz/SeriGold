@* Views/Home/Index.cshtml *@
@using SeriGold.Services.Abstracts
@inject IFaqService FaqSvc
@inject IServiceItemService ServiceSvc
@inject ISiteSettingService SiteSettingsSvc

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Ayarlar ve veriler
    var s = await SiteSettingsSvc.GetAsync();
    var faqs = await FaqSvc.GetAll();
    var services = await ServiceSvc.GetAll();

    // Meta / Tema rengi (fallback'lı)
    ViewData["Title"] = string.IsNullOrWhiteSpace(s.MetaTitle)
        ? "Seri Döviz — Güvenilir Döviz & Sarrafiye"
        : s.MetaTitle;

    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(s.MetaDescription)
        ? "Seri Döviz ile canlı döviz kurları, altın ve sarrafiye fiyatları. Hakkımızda ve iletişim bilgileri tek sayfada."
        : s.MetaDescription;

    ViewData["ThemeColor"] = string.IsNullOrWhiteSpace(s.ThemeColorHex) ? "#0b1621" : s.ThemeColorHex;

    // Listeler: sadece aktif ve sıralı
    var faqList = faqs.Where(x => x.IsActive).OrderBy(x => x.DisplayOrder).ToList();
    var svcList = services.Where(x => x.IsActive).OrderBy(x => x.DisplayOrder).ToList();

    // Google Maps embed URL (varsa query'ye output=embed ekler)
    var embedUrl = s.MapsUrl?.Contains("output=embed") == true
        ? s.MapsUrl
        : $"{s.MapsUrl}{(string.IsNullOrEmpty(s.MapsUrl) ? "" : (s.MapsUrl.Contains("?") ? "&" : "?"))}output=embed";
}

@section Styles {
    <style>
        /* Index’e özgü ufak dokunuşlar */
        .badge-row {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .45rem .75rem;
            border-radius: 999px;
            border: 1px solid var(--sg-border);
            background: var(--sg-surface-2)
        }

        .svc-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,var(--sg-gold) 0%,var(--sg-gold-2) 100%);
            color: #111
        }

        .promo-band {
            position: relative;
            overflow: hidden;
            border-radius: 16px;
            background: linear-gradient(135deg,rgba(240,194,75,.12),rgba(17,29,43,.45));
            border: 1px solid var(--sg-border)
        }

            .promo-band .dot {
                position: absolute;
                border-radius: 999px;
                filter: blur(18px);
                opacity: .4;
                pointer-events: none
            }

                .promo-band .dot.d1 {
                    width: 180px;
                    height: 180px;
                    background: var(--sg-glow);
                    left: -40px;
                    top: -40px
                }

                .promo-band .dot.d2 {
                    width: 220px;
                    height: 220px;
                    background: var(--sg-glow);
                    right: -50px;
                    bottom: -50px
                }

        .kpi .num {
            font-size: 1.6rem;
            font-weight: 700
        }

        .kpi small {
            color: var(--sg-muted-strong)
        }

        .rate-vals strong {
            font-variant-numeric: tabular-nums
        }

        .section-lead {
            max-width: 720px
        }
    </style>
}

<!-- TICKER -->
<section class="sg-anchor">
    <div class="container-xxl">
        <div class="ticker-wrap">
            <div class="ticker">
                <div class="ticker__track" id="idxTicker">
                    <span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>Yükleniyor…</span></span>
                    <span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>Kurlar çekiliyor…</span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="home" class="sg-hero py-5 sg-anchor">
    <div class="container-xxl">
        <div class="row align-items-center g-4">
            <!-- Canlı Kurlar -->
            <div class="col-12 col-lg-5">
                <div id="homeList" class="sg-card p-3 gold-border reveal tilt" data-glow>
                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                        <div class="h5 m-0">Canlı Kurlar</div>
                        <div class="d-flex align-items-center gap-2 sg-input flex-wrap flex-grow-1" style="min-width:260px">
                            <input v-model.trim="q" class="form-control form-control-sm flex-grow-1" placeholder="Ara: USD/TRY, ÇEYREK…" />
                            <label class="form-check smallmuted mb-0">
                                <input type="checkbox" v-model="favOnly" class="form-check-input me-1">Sadece ★
                            </label>
                            <a asp-controller="Home" asp-action="Doviz" class="small text-gold text-decoration-none ms-auto">Tümü</a>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height:420px">
                        <table class="table table-sm market-table sg-table">
                            <thead>
                                <tr>
                                    <th class="sticky">Ürün / Parite</th>
                                    <th class="text-end sticky">Alış</th>
                                    <th class="text-end sticky">Satış</th>
                                    <th class="text-end sticky d-none d-sm-table-cell">Değişim</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-if="!rows.length && !all.length">
                                    <td colspan="4" class="text-center smallmuted">
                                        <span class="spinner-border spinner-border-sm me-2"></span> Yükleniyor…
                                    </td>
                                </tr>
                                <tr v-for="r in rows" :key="r.symbol">
                                    <td>
                                        <i :class="isFav(r.symbol)?'bi bi-star-fill text-warning':'bi bi-star'"
                                           title="Favori" role="button" tabindex="0"
                                           @@click.stop="toggleFav(r.symbol)"
                                           @@keydown.enter.stop="toggleFav(r.symbol)"></i>
                                        <span class="ms-1">{{ disp(r.symbol) }}</span>
                                    </td>
                                    <td class="text-end price" :class="pulseCls(r)">{{ n(r.bid, disp(r.symbol)) }}</td>
                                    <td class="text-end price" :class="pulseCls(r)">
                                        {{ n(r.ask, disp(r.symbol)) }}
                                        <span class="inl-chg d-inline d-sm-none">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill drop':'bi bi-caret-up-fill rise'"></i>
                                            <small :class="dir(r)==='down'?'drop':'rise'">%{{ p(delta(r)) }}</small>
                                        </span>
                                    </td>
                                    <td class="text-end d-none d-sm-table-cell">
                                        <span class="badge-soft" :class="dir(r)==='down'?'drop':'rise'">
                                            <i :class="dir(r)==='down'?'bi bi-caret-down-fill':'bi bi-caret-up-fill'"></i>
                                            %{{ p(delta(r)) }}
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between smallmuted mt-1">
                        <span>Gösterilen: <b>{{ rows.length }}</b></span>
                        <span>Son: <b>{{ lastTs }}</b></span>
                    </div>
                </div>
            </div>

            <!-- Hero -->
            <div class="col-12 col-lg-7">
                <h1 class="display-6 fw-semibold mb-3">
                    <span class="gold-sheen">@s.BrandName</span> @s.HeroTitle
                </h1>
                <p class="lead text-muted mb-3 section-lead">@s.HeroLead</p>

                <div class="badge-row mb-4">
                    <span class="chip"><i class="bi bi-activity"></i><b>Gerçek Zamanlı</b></span>
                    <span class="chip"><i class="bi bi-shield-check"></i><b>Önce Güven</b></span>
                    <span class="chip"><i class="bi bi-cpu"></i><b>Modern Altyapı</b></span>
                    <span class="chip"><i class="bi bi-graph-up-arrow"></i><b>Şeffaf Fiyat</b></span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Home" asp-action="Doviz" class="btn btn-gold-outline btn-lg" data-ripple>Canlı Kurları Gör</a>
                    <a href="#contact" class="btn btn-secondary btn-lg" data-ripple>İletişime Geç</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PROMO BAND -->
<section class="py-4">
    <div class="container-xxl">
        <div class="promo-band p-4 p-lg-5 sg-card reveal tilt" data-glow>
            <span class="dot d1"></span><span class="dot d2"></span>
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-8">
                    <h3 class="mb-2">@s.PromoTitle</h3>
                    <p class="text-muted mb-0 section-lead">@s.PromoText</p>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="row g-3 text-center kpi">
                        <div class="col-4"><div class="num">5+ yıl</div><small>Deneyim</small></div>
                        <div class="col-4"><div class="num">24/7</div><small>Canlı Veri</small></div>
                        <div class="col-4"><div class="num">Tek Nokta</div><small>Altın & Döviz</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- HİZMETLER -->
<section id="services" class="py-5 sg-anchor">
    <div class="container-xxl">
        <div class="text-center mb-4">
            <h2 class="mb-2">Hizmetlerimiz</h2>
            <p class="text-muted section-lead mx-auto">Sarrafiye, altın ve çoklu döviz ürünlerinde şeffaf ve hızlı işlem deneyimi.</p>
        </div>
        <div class="row g-3">
            @foreach (var sv in svcList)
            {
                <div class="col-12 col-lg-4">
                    <div class="sg-card p-3 h-100 reveal tilt" data-glow>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="svc-icon"><i class="@sv.Icon"></i></span><h5 class="m-0">@sv.Title</h5>
                        </div>
                        <div class="text-muted mb-0">@Html.Raw(sv.Description)</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- NEDEN BİZ -->
<section id="why" class="py-5 sg-anchor">
    <div class="container-xxl">
        <div class="text-center mb-4"><h2 class="mb-2">Neden Seri Döviz?</h2></div>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-3"><div class="sg-card p-3 h-100 reveal tilt"><div class="d-flex align-items-start gap-2"><i class="bi bi-shield-lock text-gold fs-4"></i><div><div class="fw-semibold">Şeffaflık</div><div class="text-muted small">Açık fiyat, açık iletişim.</div></div></div></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="sg-card p-3 h-100 reveal tilt"><div class="d-flex align-items-start gap-2"><i class="bi bi-lightning-charge text-gold fs-4"></i><div><div class="fw-semibold">Hızlı İşlem</div><div class="text-muted small">Dakikalar içinde sonuç.</div></div></div></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="sg-card p-3 h-100 reveal tilt"><div class="d-flex align-items-start gap-2"><i class="bi bi-cpu text-gold fs-4"></i><div><div class="fw-semibold">Canlı Veri</div><div class="text-muted small">Anlık güncellenen kurlar.</div></div></div></div></div>
            <div class="col-12 col-md-6 col-lg-3"><div class="sg-card p-3 h-100 reveal tilt"><div class="d-flex align-items-start gap-2"><i class="bi bi-people text-gold fs-4"></i><div><div class="fw-semibold">Güler Yüz</div><div class="text-muted small">Deneyimli ekip, çözüm odaklı yaklaşım.</div></div></div></div></div>
        </div>
    </div>
</section>

<!-- HAKKIMIZDA -->
<section id="about" class="py-5 sg-anchor">
    <div class="container-xxl">
        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-7">
                <h2 class="mb-4 text-gold">HAKKIMIZDA</h2>
                <p class="text-muted mb-3"><strong>Seri Döviz</strong>, kuyumculuk sektörünün yüzyıllardır taşıdığı <em>“önce güven”</em> ilkesini temel alır. Kaliteli ve müşteri odaklı hizmet anlayışını, yenilikçi teknolojilerle birleştirerek; eski ticaretin samimiyetini, sektördeki yıllara dayanan bilgi ve deneyimle harmanlarız.</p>
                <div class="mb-4">
                    <div class="border-start ps-3 ms-1">
                        <div class="mb-3"><div class="small text-muted fw-semibold">2020</div><p class="mb-1 text-muted">Güven odaklı yaklaşımla kuyumculuk ve sarrafiyede istikrarlı operasyonumuzu kurduk.</p></div>
                        <div class="mb-0"><div class="small text-muted fw-semibold">2025</div><p class="mb-0 text-muted">Portföyümüzü genişleterek <strong>her türlü döviz alım–satımı</strong> ile tek çatı altında daha kapsamlı hizmet sunmaya başladık.</p></div>
                    </div>
                </div>
                <ul class="text-muted small mb-0">
                    <li>Güncel fiyatlara hızlı erişim</li>
                    <li>Profesyonel, güleryüzlü ekip</li>
                    <li>Şeffaf süreç ve açık bilgilendirme</li>
                </ul>
            </div>
            <div class="col-12 col-lg-5">
                <div class="text-center reveal tilt">
                    <img src="@(string.IsNullOrWhiteSpace(s.LogoUrl) ? Url.Content("~/logo.png") : s.LogoUrl)"
                         class="img-fluid" style="max-height: 460px" alt="@s.BrandName Logo" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SSS -->
<section id="faq" class="py-5 sg-anchor">
    <div class="container-xxl">
        <div class="text-center mb-4">
            <h2 class="mb-2">Sık Sorulan Sorular</h2>
            <p class="text-muted section-lead mx-auto">Kafanıza takılanları hızlıca yanıtlayalım.</p>
        </div>
        <div class="accordion reveal tilt" id="faqAcc">
            @for (int i = 0; i < faqList.Count; i++)
            {
                var it = faqList[i];
                var qid = $"q{i + 1}";
                var aid = $"a{i + 1}";
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@qid">
                        <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@aid" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@aid">
                            @it.Question
                        </button>
                    </h2>
                    <div id="@aid" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@qid" data-bs-parent="#faqAcc">
                        <div class="accordion-body text-muted">@Html.Raw(it.AnswerHtml)</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5 sg-anchor" id="cta">
    <div class="container-xxl">
        <div class="sg-card p-4 p-lg-5 d-flex flex-column flex-lg-row align-items-center justify-content-between gap-3 reveal tilt" data-glow>
            <div>
                <h3 class="mb-1">Döviz alım–satım veya sarrafiye için hızlı teklif alın.</h3>
                <div class="text-muted">Şeffaf fiyat, anlık teyit, güleryüzlü hizmet.</div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Doviz" class="btn btn-gold-outline btn-lg" data-ripple><i class="bi bi-graph-up-arrow me-1"></i> Canlı Kurlar</a>
                <a href="#contact" class="btn btn-secondary btn-lg" data-ripple><i class="bi bi-envelope me-1"></i> İletişime Geç</a>
            </div>
        </div>
    </div>
</section>

<!-- İLETİŞİM -->
<section id="contact" class="py-5 sg-anchor">
    <div class="container-xxl">
        <h4 class="text-center mb-4 fw-semibold">İLETİŞİM BİLGİSİ</h4>
        <div class="row g-4">
            <div class="col-12 col-lg-3">
                <div class="d-flex flex-column align-items-center text-center gap-5 reveal">
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border" style="width:64px;height:64px;"><i class="bi bi-telephone text-gold fs-4"></i></div>
                        <div class="small mt-3">
                            <a href="tel:@s.Phone" class="link-underline-opacity-0">@s.Phone</a>
                        </div>
                    </div>
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border" style="width:64px;height:64px;"><i class="bi bi-geo-alt text-gold fs-4"></i></div>
                        <div class="small mt-3">
                            <a href="@s.MapsUrl" target="_blank" rel="noopener" class="link-underline-opacity-0">
                                @Html.Raw((s.Address ?? "").Replace("\n", "<br/>"))
                            </a>
                        </div>
                    </div>
                    <div>
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border" style="width:64px;height:64px;"><i class="bi bi-envelope text-gold fs-4"></i></div>
                        <div class="small mt-3"><a href="mailto:@s.Email" class="link-underline-opacity-0">@s.Email</a></div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="sg-card p-3 h-100 reveal">
                    <h6 class="mb-2">Mesaj Bırakın</h6>
                    <p class="small text-muted mb-3">İstek, öneri ve talepleriniz için bize mesaj bırakabilirsiniz.</p>
                    <form method="post" novalidate class="sg-input">
                        <div class="row g-2">
                            <div class="col-12 col-md-6"><label class="form-label small text-muted">Ad</label><input type="text" class="form-control" placeholder="Ad" /></div>
                            <div class="col-12 col-md-6"><label class="form-label small text-muted">Soyad</label><input type="text" class="form-control" placeholder="Soyad" /></div>
                            <div class="col-12"><label class="form-label small text-muted">E-Posta</label><input type="email" class="form-control" placeholder="E-Posta" /></div>
                            <div class="col-12"><label class="form-label small text-muted">Mesajınız</label><textarea class="form-control" rows="6" placeholder="Mesajınız"></textarea></div>
                        </div>
                        <div class="mt-3"><button type="submit" class="btn btn-gold-outline w-100">Gönder</button></div>
                    </form>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="sg-card p-3 h-100 reveal">
                    <h6 class="mb-3">Konum Bilgisi</h6>
                    <div class="ratio ratio-4x3 mb-3">
                        <iframe src="@embedUrl"
                                width="600" height="450" style="border:0;" allowfullscreen loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
