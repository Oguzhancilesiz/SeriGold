@section Scripts {
    <script>
                const loaderMsgs = [
          'Güncel kurlar yükleniyor…',
          'Veri alınıyor…',
          'Piyasa akışı hazırlanıyor…',
          'Anlık fiyatlar geliyor…',
          'Bağlantı kuruluyor…',
          'Canlı yayın başlıyor…'
        ];
        let loadIdx = 0, idxTickerTimer = null;

        function startTickerRotator(){
          const track = document.getElementById('idxTicker');
          if(!track || idxTickerTimer) return;
          const render = () => {
            const m1 = loaderMsgs[loadIdx % loaderMsgs.length];
            const m2 = loaderMsgs[(loadIdx+1) % loaderMsgs.length];
            track.innerHTML =
              `<span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>${m1}</span></span>`+
              `<span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>${m2}</span></span>`;
            loadIdx = (loadIdx+1) % loaderMsgs.length;
          };
          render();
          idxTickerTimer = setInterval(render, 1400);
        }
        function stopTickerRotator(){
          if(idxTickerTimer){ clearInterval(idxTickerTimer); idxTickerTimer=null; }
        }

        (function(){
          const API = { latest: '/api/rates/latest' };
          const EPS=1e-9;
          function truncTo(v,d){ const f=Math.pow(10,d); return Math.trunc((+v)*f)/f; }
          function dp(sym){
            if(!sym) return 6;
            if(sym==='ONS' || sym==='XAU/USD') return 1;
            if(/GRAM|KG\(|GREMSE|ÇEYREK|YARIM|TAM|ATA/.test(sym)) return 2;
            if(/\/JPY$|\/HUF$|\/KRW$|\/IDR$/.test(sym)) return 3;
            if(/\/TRY$/.test(sym)) return 4;
            return 6;
          }
          function fmt(v,sym){
            if(v==null) return '—';
            const d=dp(sym), t=truncTo(v,d);
            return t.toLocaleString('tr-TR',{minimumFractionDigits:d,maximumFractionDigits:d});
          }
          function pcent(v){
            const n=Number(v); if(!isFinite(n)) return '0,00';
            const abs=Math.abs(n), d=abs<0.01?3:2;
            const t=truncTo(n,d);
            const out=t.toLocaleString('tr-TR',{minimumFractionDigits:d,maximumFractionDigits:d});
            return out==='-0,00'?'0,00':out;
          }
          const prev = new Map(); // flash için
          const baseKey = 'rates.base.'+(new Intl.DateTimeFormat('tr-TR',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()).split('.').reverse().join('-'));
          let baseMap = new Map(Object.entries(JSON.parse(localStorage.getItem(baseKey)||'{}')).map(([k,v])=>[k,+v]));

          // DOM hedefleri
          const targets = [
            { sym:'USD/TRY', bid: 'USDTRY-bid', ask:'USDTRY-ask', card:'card-USDTRY', ch:'USDTRY-ch', dir:'USDTRY-dir', as:'USD/TRY' },
            { sym:'EUR/TRY', bid: 'EURTRY-bid', ask:'EURTRY-ask', card:'card-EURTRY', ch:'EURTRY-ch', dir:'EURTRY-dir', as:'EUR/TRY' },
            { sym:'ALTIN/GRAM', bid: 'ALTINGRAM-bid', ask:'ALTINGRAM-ask', card:'card-ALTINGRAM', ch:'ALTINGRAM-ch', dir:'ALTINGRAM-dir', as:'ALTIN/GRAM' },
            { sym:'XAU/USD', as:'ONS', bid: 'ONS-bid', ask:'ONS-ask', card:'card-ONS', ch:'ONS-ch', dir:'ONS-dir' }
          ];

          function mid(bid,ask){
            if(bid==null && ask==null) return null;
            if(bid==null) return +ask;
            if(ask==null) return +bid;
            return ((+bid)+(+ask))/2;
          }

          function apply(list){
            const map = new Map(list.filter(x=>x.symbol).map(x => [x.symbol, x]));

            // Ticker
            const top = ['ALTIN/GRAM','XAU/USD','USD/KG(ALTIN)','EUR/KG(ALTIN)','GÜMÜŞ/GRAM','USD/TRY','EUR/TRY','EUR/USD','USD/JPY'];
            const rows = [];
            for(const k of top){
              const r = map.get(k);
              if(!r) continue;
              const symLabel = (k==='XAU/USD')?'ONS':k;
              const b=r.bid,a=r.ask;
              const m=mid(b,a);
              // % change
              let base = baseMap.get(k);
              if(base==null && m!=null && m>0){ baseMap.set(k,m); localStorage.setItem(baseKey, JSON.stringify(Object.fromEntries(baseMap))); base=m; }
              let ch = 0;
              if(base!=null && m!=null && base) ch = ((m-base)/base)*100;
              rows.push({label:symLabel,value:(a??b),delta:ch});
            }
            if(rows.length){
                stopTickerRotator();

              const track = document.getElementById('idxTicker');
              if(track){
                const dbl = rows.concat(rows);
                track.innerHTML = dbl.map(t=>(
                  `<span class="ticker__item">
                     <span class="lbl">${t.label}</span>
                     <span class="val price ${t.delta>=0?'rise':'drop'}">${fmt(t.value, t.label)}</span>
                     <i class="${t.delta>=0?'bi bi-caret-up-fill rise':'bi bi-caret-down-fill drop'}"></i>
                     <small class="${t.delta>=0?'rise':'drop'}">%${pcent(t.delta)}</small>
                   </span>`
                )).join('');
              }
              try{ window.PageLoader && PageLoader.hide(); }catch(_){}
            }

            // Kartlar
            targets.forEach(t=>{
              const r = map.get(t.sym);
              const symLabel = t.as || t.sym;
              const bidEl = document.getElementById(t.bid);
              const askEl = document.getElementById(t.ask);
              const card  = document.getElementById(t.card);
              const chEl  = document.getElementById(t.ch);
              const dirEl = document.getElementById(t.dir);
              if(!bidEl || !askEl) return;

              const b = r ? r.bid : null;
              const a = r ? r.ask : null;

              // soft flash (orta değer değiştiyse)
              if(card && r){
                const m = mid(b,a);
                const pv = prev.get(t.sym);
                if(pv!=null && m!=null && Math.abs(m - pv) > EPS){
                  card.classList.remove('flash-up'); void card.offsetWidth; card.classList.add('flash-up');
                }
                if(m!=null) prev.set(t.sym, m);

                // % change
                let base = baseMap.get(t.sym);
                if(base==null && m!=null && m>0){ baseMap.set(t.sym,m); localStorage.setItem(baseKey, JSON.stringify(Object.fromEntries(baseMap))); base=m; }
                let ch = 0;
                if(base!=null && m!=null && base) ch = ((m-base)/base)*100;
                if(chEl) chEl.textContent = pcent(ch);
                if(dirEl){
                  dirEl.className = ch>=0 ? 'bi bi-caret-up-fill rise' : 'bi bi-caret-down-fill drop';
                }
              }

              bidEl.textContent = fmt(b, symLabel);
              askEl.textContent = fmt(a, symLabel);
            });
          }

          function norm(list){
            return (list||[]).map(x=>({
              symbol: x.symbol||x.Symbol||x.code||x.Code,
              bid:    (x.bid??x.Bid??x.buy??x.Buy),
              ask:    (x.ask??x.Ask??x.sell??x.Sell)
            }));
          }

          function pull(){
            fetch(API.latest, { cache: 'no-store' })
              .then(r=>{ if(!r.ok) throw new Error('http'); return r.json(); })
              .then(j => apply(norm(j)))
              .catch(()=>{ /* sessizce */ });
          }

          try{ window.PageLoader && PageLoader.show(); }catch(_){}
          pull();
                  try{ window.PageLoader && PageLoader.setMessages(loaderMsgs); }catch(_){}
        startTickerRotator();
          const tmr = setInterval(pull, 2000);
          document.addEventListener('visibilitychange', ()=>{ if(!document.hidden) pull(); });
        })();
    </script>
}
