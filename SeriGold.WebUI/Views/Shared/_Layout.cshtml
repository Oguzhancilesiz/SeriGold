@* Views/Shared/_Layout.cshtml *@
@using SeriGold.Services.Abstracts
@inject ISiteSettingService SiteSettingsSvc
@{
    var s = await SiteSettingsSvc.GetAsync();

    var title = (ViewData["Title"] as string) ?? (string.IsNullOrWhiteSpace(s?.MetaTitle) ? "Seri Döviz — Güvenilir Döviz & Sarrafiye" : s.MetaTitle);
    var desc = (ViewData["MetaDescription"] as string) ?? (string.IsNullOrWhiteSpace(s?.MetaDescription) ? "Seri Döviz ile canlı döviz kurları, altın ve sarrafiye fiyatları." : s.MetaDescription);
    var theme = string.IsNullOrWhiteSpace(s?.ThemeColorHex) ? "#0b1621" : s.ThemeColorHex;
    var brand = string.IsNullOrWhiteSpace(s?.BrandName) ? "Seri Döviz" : s.BrandName;
    var logo = string.IsNullOrWhiteSpace(s?.LogoUrl) ? Url.Content("~/logo.png") : s.LogoUrl;
}

<!doctype html>
<html lang="tr" data-theme="seridoviz-dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>@title</title>
    <meta name="description" content="@desc" />
    <meta name="theme-color" id="themeColorMeta" content="@theme" />

    <link rel="icon" href="~/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="~/logo.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/logo.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/logo.png">
    <link rel="manifest" href="~/favicon/site.webmanifest">
    <link rel="mask-icon" href="~/logo.png" color="#d4af37">
    <meta name="msapplication-TileColor" content="#0b1621">

    <script>
        try {
          const k='seridoviz.theme';
          const saved=localStorage.getItem(k);
          const t=saved?saved:(matchMedia('(prefers-color-scheme: dark)').matches?'seridoviz-dark':'seridoviz-light');
          document.documentElement.setAttribute('data-theme', t);
        } catch(e){}
    </script>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    @RenderSection("HeadMeta", required: false)
</head>
<body class="sg-body">
    <div class="sg-ambient" aria-hidden="true"></div>

    <div id="pageLoader" class="page-loader" role="status" aria-live="polite" aria-label="Yükleniyor" hidden>
        <div class="box">
            <span class="spinner-border spinner-border-sm" role="presentation"></span>
            <strong id="pageLoaderText" aria-live="polite">Güncel kurlar yükleniyor…</strong>
        </div>
    </div>

    <header class="sg-navbar fixed-top">
        <nav class="navbar navbar-expand-lg" aria-label="Ana menü">
            <div class="container-xxl sg-navgrid">
                <!-- SOL -->
                <div class="sg-left d-none d-lg-flex">
                    <ul class="navbar-nav sg-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Doviz">Kurlar</a></li>
                        @if (s?.ShowAbout == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">Hakkımızda</a></li>
                        }
                        @if (s?.ShowContact == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact">İletişim</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="faq">SSS</a></li>
                    </ul>
                </div>

                <!-- ORTA: Logo -->
                <a class="navbar-brand sg-brand center d-flex align-items-center justify-content-center"
                   asp-controller="Home" asp-action="Index" aria-label="@brand">
                    <span class="brand-ring" aria-hidden="true"></span>
                    <img class="brand-logo" src="@logo" alt="@brand" />
                </a>

                <!-- SAĞ -->
                <div class="sg-right d-flex align-items-center justify-content-end gap-2">
                    <a class="icon-btn lg d-none d-lg-inline-flex" asp-controller="Home" asp-action="Doviz" title="Canlı Kurlar" data-bs-toggle="tooltip" data-bs-title="Canlı Kurlar" data-ripple>
                        <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    </a>
                    <button id="themeBtn" class="btn btn-gold-outline btn-md d-flex align-items-center gap-2" type="button" data-ripple>
                        <i class="bi" id="themeIcon" aria-hidden="true"></i>
                        <span id="themeText" class="d-none d-sm-inline"></span>
                    </button>
                    <button class="btn btn-outline-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mNav" aria-controls="mNav" aria-label="Menüyü aç">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>
            <div class="nav-glow" aria-hidden="true"></div>
        </nav>
    </header>

    <!-- Mobil Offcanvas -->
    <div class="offcanvas offcanvas-end bg-body-tertiary" tabindex="-1" id="mNav" aria-labelledby="mNavLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mNavLabel">@brand</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column gap-1">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Ana Sayfa</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Doviz"><i class="bi bi-graph-up-arrow me-2"></i>Kurlar</a></li>
                @if (s?.ShowAbout == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about"><i class="bi bi-info-circle me-2"></i>Hakkımızda</a></li>
                }
                @if (s?.ShowContact == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact"><i class="bi bi-telephone me-2"></i>İletişim</a></li>
                }
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="faq"><i class="bi bi-question-circle me-2"></i>SSS</a></li>
            </ul>
        </div>
    </div>

    <main class="sg-main">
        <div id="legalNoticeBar" class="notice-bar" role="alert" aria-live="polite">
            <div class="container-xxl d-flex align-items-center gap-3 py-2">
                <i class="bi bi-exclamation-octagon-fill flex-shrink-0"></i>
                <span class="notice-text">Paylaşılan fiyatlar bilgilendirme amaçlıdır; yatırım tavsiyesi değildir.</span>
                <button type="button" class="btn-close ms-auto" aria-label="Kapat"></button>
            </div>
        </div>

        @RenderBody()
    </main>

    <nav class="sg-bottomnav d-lg-none" aria-label="Alt gezinti">
        <a class="bn-item nav-link" asp-controller="Home" asp-action="Index" data-ripple>
            <i class="bi bi-house"></i><span>Ana</span>
        </a>
        <a class="bn-item nav-link" asp-controller="Home" asp-action="Doviz" data-ripple>
            <i class="bi bi-graph-up-arrow"></i><span>Kurlar</span>
        </a>
        <a class="bn-item nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about" data-ripple>
            <i class="bi bi-info-circle"></i><span>Hakkımızda</span>
        </a>
        <a class="bn-item nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact" data-ripple>
            <i class="bi bi-telephone"></i><span>İletişim</span>
        </a>
        <span class="bn-ink" aria-hidden="true"></span>
    </nav>

    <footer class="sg-footer mt-4">
        <div class="container-xxl">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 py-3 mt-3 border-top sglib-border">
                <div class="small text-muted text-center text-md-start">
                    © @DateTime.Now.Year @brand • Tüm hakları saklıdır.
                    <span class="d-none d-md-inline"> • </span><br class="d-md-none" />
                    <span class="text-subtle">@Html.Raw(s?.FooterNoteHtml ?? "")</span>
                </div>
                <ul class="nav small">
                    <li class="nav-item"><a class="nav-link px-2 text-muted" href="#" data-bs-toggle="modal" data-bs-target="#privacyModal">Gizlilik Politikası</a></li>
                    <li class="nav-item"><a class="nav-link px-2 text-muted" href="#" data-bs-toggle="modal" data-bs-target="#kvkkPolicyModal">KVKK</a></li>
                    <li class="nav-item"><a class="nav-link px-2 text-muted" href="#" data-bs-toggle="modal" data-bs-target="#aydModal">Aydınlatma Metni</a></li>
                    <li class="nav-item"><a class="nav-link px-2 text-muted" href="#" data-bs-toggle="modal" data-bs-target="#cookieModal">Çerez Kullanımı</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <button id="toTop" class="to-top icon-btn" type="button" aria-label="Yukarı" data-ripple>
        <i class="bi bi-chevron-up"></i>
    </button>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)

    <!-- Modals (DB içerikleri) -->
    <div class="modal fade modal-seri" id="privacyModal" tabindex="-1" aria-labelledby="privacyLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 id="privacyLabel" class="modal-title">Gizlilik Politikası</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">@Html.Raw(s?.PrivacyHtml ?? "")</div>
                <div class="modal-footer"><button class="btn btn-gold-outline" data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>

    <div class="modal fade modal-seri" id="kvkkPolicyModal" tabindex="-1" aria-labelledby="kvkkLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 id="kvkkLabel" class="modal-title">KVKK Politikası</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">@Html.Raw(s?.KvkkHtml ?? "")</div>
                <div class="modal-footer"><button class="btn btn-gold-outline" data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>

    <div class="modal fade modal-seri" id="aydModal" tabindex="-1" aria-labelledby="aydLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 id="aydLabel" class="modal-title">Kişisel Verilerin İşlenmesine İlişkin Aydınlatma Metni</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">@Html.Raw(s?.AydinlatmaHtml ?? "")</div>
                <div class="modal-footer"><button class="btn btn-gold-outline" data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>

    <div class="modal fade modal-seri" id="cookieModal" tabindex="-1" aria-labelledby="cookieLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 id="cookieLabel" class="modal-title">Çerez (Cookie) Politikası</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
                <div class="modal-body">@Html.Raw(s?.CookieHtml ?? "")</div>
                <div class="modal-footer"><button class="btn btn-gold-outline" data-bs-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>

    <!-- Libs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@2.7.16/dist/vue.min.js"></script>

    <!-- Global Rates Script (senin bloğun) -->
    <script>
        (function () {
          const API = { latest: '/api/rates/latest', hub: '/ratesHub' };
          const IST = 'Europe/Istanbul';
          const EPS = 1e-9;

          const roundTo=(v,d)=>{const f=10**d;return Math.round((+v)*f)/f;};
          const dp=(sym)=>{if(!sym)return 6;if(sym==='ONS'||sym==='XAU/USD')return 1;
            if(/GRAM|KG\(|GREMSE|ÇEYREK|YARIM|TAM|ATA|AYAR/.test(sym))return 2;
            if(/\/JPY$|\/HUF$|\/KRW$|\/IDR$/.test(sym))return 3;
            if(/\/TRY$|^TRY\//.test(sym))return 4;return 6;};
          const fmt=(v,sym)=>v==null?'—':roundTo(v,dp(sym)).toLocaleString('tr-TR',{minimumFractionDigits:dp(sym),maximumFractionDigits:dp(sym)});
          const pcent=(v)=>{const n=Number(v);if(!isFinite(n))return'0,00';const d=Math.abs(n)<0.01?3:2;
            const r=roundTo(n,d).toLocaleString('tr-TR',{minimumFractionDigits:d,maximumFractionDigits:d});return r==='-0,00'?'0,00':r;};
          const mid=(b,a)=>(b==null&&a==null)?null:(b==null?+a:(a==null?+b:((+b)+(+a))/2));
          const nowTR=()=>new Date().toLocaleTimeString('tr-TR',{hour12:false,timeZone:IST});
          const dayKey=()=>{const f=new Intl.DateTimeFormat('tr-TR',{timeZone:IST,year:'numeric',month:'2-digit',day:'2-digit'});const[g,a,y]=f.format(new Date()).split('.');return`${y}-${a}-${g}`;};

          const isMetal=(s)=> s==='XAU/USD' || /(GRAM|KG\(|GREMSE|ÇEYREK|YARIM|TAM|ATA|AYAR|XAG\/USD|XPT\/USD|XPD\/USD|GÜMÜŞ\/GRAM)/.test(s);
          const isTryPair=(s)=> /\/TRY$|^TRY\//.test(s);

          const Bus={listeners:new Set(),on(fn){this.listeners.add(fn);},off(fn){this.listeners.delete(fn);},emit(p){for(const f of this.listeners){try{f(p);}catch{}}}};
          window.Bus=Bus;

          const FX_KEY='fx.anchor.usdtry';
          const RatesFX={
            getAnchor(){const v=localStorage.getItem(FX_KEY);return v?+v:null;},
            setAnchor(v){const n=Number(v);if(isFinite(n)&&n>0){localStorage.setItem(FX_KEY,String(n));toast(`FX anchor USD/TRY = ${n}`);}},
            clearAnchor(){localStorage.removeItem(FX_KEY);toast('FX anchor temizlendi');},
            calibrate(list){
              const target=this.getAnchor(); if(!target) return list;
              const rows=[...list];
              const utry=rows.find(r=>r.symbol==='USD/TRY');
              const curr=utry?mid(utry.bid,utry.ask):null;
              if(!curr) return list;
              const k=target/curr;
              return rows.map(r=>{
                if(isMetal(r.symbol))return r;
                if(!isTryPair(r.symbol))return r;
                const m0=mid(r.bid,r.ask);
                const sp0=(r.bid!=null&&r.ask!=null)?(+r.ask-+r.bid):0;
                const m=/^TRY\//.test(r.symbol)?(m0!=null?m0/k:null):(m0!=null?m0*k:null);
                const sp=/^TRY\//.test(r.symbol)?sp0/k:sp0*k;
                const half=sp/2;
                const out={...r};
                if(m!=null){ out.bid=m-half; out.ask=m+half; }
                if(typeof r.prevClose==='number'&&isFinite(r.prevClose)){
                  out.prevClose=/^TRY\//.test(r.symbol)?r.prevClose/k:r.prevClose*k;
                }
                return out;
              });
            }
          };
          window.RatesFX=RatesFX;

          document.addEventListener('keydown',(e)=>{
            if(e.altKey&&(e.key==='d'||e.key==='D')){
              const cur=RatesFX.getAnchor()??'';
              const v=prompt('Dövizborsa USD/TRY (Satış) değeri:',cur);
              if(v!=null&&v.trim()){RatesFX.setAnchor(v.trim());}
            }
          });

          function toast(msg){
            try{
              let n=document.getElementById('sgToast');
              if(!n){n=document.createElement('div');n.id='sgToast';
                n.style.cssText='position:fixed;z-index:99999;left:50%;bottom:18px;transform:translateX(-50%);padding:.5rem .75rem;border-radius:10px;background:#111c;color:#fff;border:1px solid #333;box-shadow:0 6px 24px rgba(0,0,0,.35);font:500 13px/1.3 system-ui,Segoe UI,Roboto';
                document.body.appendChild(n);}
              n.textContent=msg;n.style.opacity='1';setTimeout(()=>{n.style.transition='opacity .4s';n.style.opacity='0';},1600);
            }catch{}
          }

          function norm(list){
            return (list||[]).map(x=>{
              let bid=(x.bid??x.Bid??x.buy??x.Buy);
              let ask=(x.ask??x.Ask??x.sell??x.Sell);
              if(bid!=null&&ask!=null&&+ask<+bid){const t=bid;bid=ask;ask=t;}
              return{symbol:x.symbol||x.Symbol||x.code||x.Code,bid,ask,change:(typeof x.change==='number'?+x.change:(typeof x.Change==='number'?+x.Change:null)),
                prevClose:(typeof x.prevClose==='number'?+x.prevClose:(typeof x.PrevClose==='number'?+x.PrevClose:null)),dir:(x.dir||x.Dir||null)};
            }).filter(x=>x.symbol);
          }

          const baseKey='rates.base.'+dayKey();
          let baseMap=new Map(Object.entries(JSON.parse(localStorage.getItem(baseKey)||'{}')).map(([k,v])=>[k,+v]));
          const saveBase=()=>localStorage.setItem(baseKey,JSON.stringify(Object.fromEntries(baseMap)));

          const State={prev:new Map(),lastPush:0};
          function enrich(arr,prevState){
            let baseChanged=false;
            for(const it of arr){
              const sym=it.symbol; const m=mid(it.bid,it.ask); const pv=prevState.get(sym);
              if(typeof it.change==='number'&&isFinite(it.change)){
                it._delta=it.change; it._dir=(it.dir==='down')?'down':(it._delta<0?'down':'up');
              } else if(typeof it.prevClose==='number'&&isFinite(it.prevClose)&&m!=null){
                it._delta=((m-it.prevClose)/it.prevClose)*100; it._dir=it._delta<0?'down':'up';
              } else {
                let base=baseMap.get(sym);
                if(base==null&&m!=null&&m>0){baseMap.set(sym,m);base=m;baseChanged=true;}
                it._delta=(base!=null&&m!=null&&Math.abs(base)>EPS)?((m-base)/base)*100:(pv&&typeof pv.delta==='number'?pv.delta:0);
                it._dir=(pv&&pv.v!=null&&m!=null)?(m>=pv.v?'up':'down'):(it._delta<0?'down':'up');
              }
              if(pv&&pv.v!=null&&m!=null&&Math.abs(m-pv.v)>EPS){
                it._pulse=(m>=pv.v)?'up':'down'; setTimeout(()=>{try{it._pulse=null;}catch{}},600);
              }
              if(m!=null) prevState.set(sym,{v:m,delta:it._delta,dir:it._dir});
            }
            if(baseChanged) saveBase();
          }

          function handlePayload(payload){
            let arr=norm(payload);
            arr=RatesFX.calibrate(arr);
            const latest=new Map(); for(const r of arr) latest.set(r.symbol,r);
            arr=[...latest.values()].sort((a,b)=>a.symbol.localeCompare(b.symbol));
            enrich(arr,State.prev);
            Bus.emit(arr);
            State.lastPush=Date.now();
          }

          async function pull(){ try{ const r=await fetch(API.latest,{cache:'no-store'}); if(!r.ok)return; handlePayload(await r.json()); }catch{} }

          ;(function startHub(){
            if(!window.signalR){ pull(); return; }
            const hub=new signalR.HubConnectionBuilder()
              .withUrl(API.hub,{transport:signalR.HttpTransportType.WebSockets})
              .withAutomaticReconnect({ nextRetryDelayInMilliseconds: c => Math.min(5000,(c.previousRetryCount+1)*1000) })
              .configureLogging(signalR.LogLevel.Error).build();
            hub.serverTimeoutInMilliseconds=30000;
            hub.keepAliveIntervalInMilliseconds=10000;
            hub.on('rates:update',handlePayload);
            hub.onreconnected(()=>pull());
            hub.start().catch(()=>{});
            pull();
            setInterval(()=>{ if(Date.now()-State.lastPush>10000) pull(); },5000);
            document.addEventListener('visibilitychange',()=>{ if(!document.hidden) pull(); });
          })();

          // Ticker (varsa)
          const loaderMsgs=['Güncel kurlar yükleniyor…','Veri alınıyor…','Piyasa akışı hazırlanıyor…','Anlık fiyatlar geliyor…','Bağlantı kuruluyor…','Canlı yayın başlıyor…'];
          let loadIdx=0,idxTickerTimer=null;
          function startTickerRotator(){
            const track=document.getElementById('idxTicker'); if(!track||idxTickerTimer) return;
            const render=()=>{const m1=loaderMsgs[loadIdx%loaderMsgs.length],m2=loaderMsgs[(loadIdx+1)%loaderMsgs.length];
              track.innerHTML=`<span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>${m1}</span></span>`+
                              `<span class="ticker__item"><span class="spinner-border spinner-border-sm"></span> <span>${m2}</span></span>`;
              loadIdx=(loadIdx+1)%loaderMsgs.length;};
            render(); idxTickerTimer=setInterval(render,1400);
          }
          function stopTickerRotator(){ if(idxTickerTimer){ clearInterval(idxTickerTimer); idxTickerTimer=null; } }
          startTickerRotator();

          function renderHomeTicker(rowsMap){
            const track=document.getElementById('idxTicker'); if(!track) return;
            const top=['ALTIN/GRAM','XAU/USD','USD/KG(ALTIN)','EUR/KG(ALTIN)','GÜMÜŞ/GRAM','USD/TRY','EUR/TRY','EUR/USD','USD/JPY'];
            const out=[];
            for(const k of top){ const r=rowsMap.get(k); if(!r) continue; const label=(k==='XAU/USD')?'ONS':k; out.push({label,value:(r.ask??r.bid),delta:r._delta});}
            if(!out.length) return; stopTickerRotator();
            const dbl=out.concat(out);
            track.innerHTML=dbl.map(t=>`
              <span class="ticker__item">
                <span class="lbl">${t.label}</span>
                <span class="val price ${t.delta>=0?'rise':'drop'}">${fmt(t.value,t.label)}</span>
                <i class="${t.delta>=0?'bi bi-caret-up-fill rise':'bi bi-caret-down-fill drop'}"></i>
                <small class="${t.delta>=0?'rise':'drop'}">%${pcent(t.delta)}</small>
              </span>`).join('');
          }

          Bus.on(arr=>{
            const map=new Map(arr.map(x=>[x.symbol,x]));
            renderHomeTicker(map);
            if(window.homeVm) window.homeVm.apply(arr);
            if(window.dovizVm) window.dovizVm.apply(arr);
            document.getElementById('pageLoader')?.setAttribute('hidden','');
          });

          // Home VM (varsa)
          (function mountHome(){
            const el=document.getElementById('homeList'); if(!el) return;
            window.homeVm=new Vue({
              el:'#homeList',
              data(){return{all:[],prev:new Map(),lastTs:'--:--:--',favs:new Set(JSON.parse(localStorage.getItem('favSymbols')||'[]')),q:'',favOnly:false};},
              computed:{
                popularOrder(){return['USD/TRY','EUR/TRY','ALTIN/GRAM','XAU/USD','YENİ ÇEYREK','EUR/USD','USD/JPY','GÜMÜŞ/GRAM'];},
                rows(){
                  const q=(this.q||'').trim().toUpperCase();
                  const dict=new Map(this.all.map(x=>[x.symbol,x]));
                  const pinned=this.popularOrder.map(s=>dict.get(s)).filter(Boolean);
                  const favs=[...this.favs].map(s=>dict.get(s)).filter(Boolean).filter(r=>!this.popularOrder.includes(r.symbol));
                  const rest=this.all.filter(r=>!this.popularOrder.includes(r.symbol)&&!this.favs.has(r.symbol))
                                     .sort((a,b)=>this.w(b.symbol)-this.w(a.symbol)||a.symbol.localeCompare(b.symbol));
                  let out=[...pinned,...favs,...rest];
                  if(this.favOnly) out=out.filter(r=>this.favs.has(r.symbol)||this.popularOrder.includes(r.symbol));
                  if(q) out=out.filter(r=>(r.symbol||'').includes(q)||this.disp(r.symbol).includes(q));
                  return out;
                }
              },
              methods:{
                disp(sym){return sym==='XAU/USD'?'ONS':sym;},
                w(sym){if(/\/TRY$|^TRY\//.test(sym))return 90;if(sym==='XAU/USD'||/GRAM|ÇEYREK|YARIM|TAM|ATA|GREMSE|AYAR/.test(sym))return 80;if(/\/USD$|^USD\/|\/EUR$|^EUR\//.test(sym))return 60;return 20;},
                toggleFav(sym){const s=new Set(this.favs);s.has(sym)?s.delete(sym):s.add(sym);this.favs=s;localStorage.setItem('favSymbols',JSON.stringify([...s]));},
                isFav(sym){return this.favs.has(sym);},
                n(v,sym){return fmt(v,this.disp(sym));},
                p(v){return pcent(v);},
                delta(r){return (typeof r._delta==='number')?r._delta:0;},
                dir(r){return (r._dir==='down')?'down':'up';},
                pulseCls(r){return r?(r._pulse==='down'?'flash-down':(r._pulse==='up'?'flash-up':'')):'';},
                apply(list){
                  const latest=new Map();for(const r of list) latest.set(r.symbol,r);
                  const arr=[...latest.values()].sort((a,b)=>a.symbol.localeCompare(b.symbol));
                  this.all=arr; this.lastTs=nowTR();
                }
              }
            });
          })();

          // Doviz VM (varsa)
          (function mountDoviz(){
            const el=document.getElementById('dovizApp'); if(!el) return;
            window.dovizVm=new Vue({
              el:'#dovizApp',
              data(){return{all:[],lastTs:'--:--:--',favs:new Set(JSON.parse(localStorage.getItem('favSymbols')||'[]')),
                convAmt:1,convPair:'@((s?.DefaultConverterPair) ?? "EUR/TRY")',convMode:'mid',convDir:false,
                activeTab:'metals',fxTab:'@((s?.DefaultFxTab) ?? "TRY")',qFx:'',fxFavOnly:false,dense:false,
                loadMsgs:['Güncel kurlar yükleniyor…','Veri alınıyor…','Piyasa akışı hazırlanıyor…','Anlık fiyatlar geliyor…','Bağlantı kuruluyor…','Canlı yayın başlıyor…'],loadIdx:0};},
              computed:{
                loadMsg(){return this.loadMsgs[this.loadIdx%this.loadMsgs.length];},
                nextLoadMsg(){return this.loadMsgs[(this.loadIdx+1)%this.loadMsgs.length];},
                pairs(){return Array.from(new Set(this.all.map(x=>x.symbol))).sort();},
                convPairSplit(){return (this.convPair||'').split('/');},
                convPairDisplay(){return this.convPairSplit[1]?(this.convDir?(this.convPairSplit[1]+'/'+this.convPairSplit[0]):this.convPair):(this.convPair||'');},
                convUnitRate(){const px=this.priceOf(this.convPair,this.convMode);if(px==null||px<=0)return null;return this.convDir?(1/px):px;},
                convResult(){const u=this.convUnitRate;if(u==null)return null;const a=Number(this.convAmt);if(!isFinite(a))return null;return a*u;},
                convModeLabel(){return this.convMode==='mid'?'Orta':(this.convMode==='bid'?'Alış':'Satış');},
                topList(){const base=['ALTIN/GRAM','XAU/USD','USD/KG(ALTIN)','EUR/KG(ALTIN)','GÜMÜŞ/GRAM','USD/TRY','EUR/TRY','EUR/USD','USD/JPY'];
                  const bySym=new Map(this.all.map(x=>[x.symbol,x]));const favs=[...this.favs].map(s=>bySym.get(s)).filter(Boolean);
                  const baseItems=base.map(s=>bySym.get(s)).filter(Boolean);
                  const uniq=[...new Map([...favs,...baseItems].map(r=>[r.symbol,r])).values()];
                  return uniq.map(r=>({label:r.symbol==='XAU/USD'?'ONS':r.symbol,value:(r.ask??r.bid),delta:this.delta(r)}));},
                tickerDoubled(){return this.topList.concat(this.topList);},
                metals(){const order=['ALTIN/GRAM','ONS','USD/KG(ALTIN)','EUR/KG(ALTIN)','AYAR22/GRAM','AYAR14/GRAM','GÜMÜŞ/GRAM','XAG/USD','XPT/USD','XPD/USD'];
                  const rows=this.all.map(r=> (r.symbol==='XAU/USD'? {...r,_disp:'ONS'} : {...r,_disp:r.symbol}));
                  const dict=new Map(rows.map(x=>[x._disp,x])); return order.map(k=>dict.get(k)).filter(Boolean);},
                mint(){const names=['YENİ ÇEYREK','ESKİ ÇEYREK','YENİ YARIM','ESKİ YARIM','YENİ TAM','ESKİ TAM','YENİ ATA','ESKİ ATA','YENİ ATA5','ESKİ ATA5','YENİ GREMSE','ESKİ GREMSE'];
                  const dict=new Map(this.all.filter(x=>names.includes(x.symbol)).map(x=>[x.symbol,x])); return names.map(n=>dict.get(n)).filter(Boolean);},
                tabRows(){return this.activeTab==='metals'?this.metals:this.mint;},
                fxTryFull(){const q=(this.qFx||'').trim().toUpperCase(); let f=this.all.filter(x=>/\/TRY$/.test(x.symbol));
                  if(this.fxFavOnly) f=f.filter(x=>this.isFav(x.symbol)); if(q) f=f.filter(x=>x.symbol.includes(q)); return f;},
                fxUsdFull(){const q=(this.qFx||'').trim().toUpperCase(); let f=this.all.filter(x=>/\/USD$|^USD\//.test(x.symbol));
                  if(this.fxFavOnly) f=f.filter(x=>this.isFav(x.symbol)); if(q) f=f.filter(x=>x.symbol.includes(q)); return f;},
                fxEur(){const q=(this.qFx||'').trim().toUpperCase(); let f=this.all.filter(x=>/\/EUR$|^EUR\//.test(x.symbol));
                  if(this.fxFavOnly) f=f.filter(x=>this.isFav(x.symbol)); if(q) f=f.filter(x=>x.symbol.includes(q)); return f;},
                fxTabRows(){return this.fxTab==='USD'?this.fxUsdFull:(this.fxTab==='EUR'?this.fxEur:this.fxTryFull);}
              },
              methods:{
                n(v,sym){return fmt(v,sym);}, p(v){return pcent(v);},
                toggleFav(sym){const s=new Set(this.favs);s.has(sym)?s.delete(sym):s.add(sym);this.favs=s;localStorage.setItem('favSymbols',JSON.stringify([...s]));},
                isFav(sym){return this.favs.has(sym);},
                delta(r){return (typeof r._delta==='number')?r._delta:0;},
                dir(r){return (r._dir==='down')?'down':'up';},
                pulseCls(r){return r?(r._pulse==='down'?'flash-down':(r._pulse==='up'?'flash-up':'')):'';},
                fmtSym(r){return this.activeTab==='metals'?(r.symbol==='XAU/USD'?'ONS':r.symbol):r.symbol;},
                priceOf(sym,mode){const r=this.all.find(x=>x.symbol===sym); if(!r) return null; const m=mid(r.bid,r.ask);
                  if(mode==='bid') return (r.bid!=null)?+r.bid:(m!=null?m:null);
                  if(mode==='ask') return (r.ask!=null)?+r.ask:(m!=null?m:null);
                  return m;},
                copyConv(){try{
                  const txt=this.convResult==null?'':`${fmt(this.convAmt,this.convPairSplit[0])} ${this.convPairSplit[0]} ≈ ${fmt(this.convResult,this.convPairDisplay)} ${this.convPairDisplay.split('/')[1]} (${this.convModeLabel})`;
                  if(txt) navigator.clipboard.writeText(txt);}catch{}},
                apply(list){
                  const latest=new Map(); for(const r of list) latest.set(r.symbol,r);
                  const arr=[...latest.values()].sort((a,b)=>a.symbol.localeCompare(b.symbol));
                  if(!arr.find(x=>x.symbol===this.convPair) && arr.length) this.convPair=arr[0].symbol;
                  this.all=arr; this.lastTs=nowTR();
                }
              }
            });
          })();
        })();
    </script>

    <!-- UI helpers -->
    <script>
        (function(){
          // tooltips
          [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]')).map(el => new bootstrap.Tooltip(el));
          // notice kapat
          document.querySelector('#legalNoticeBar .btn-close')?.addEventListener('click',()=>document.getElementById('legalNoticeBar')?.classList.add('d-none'));
          // tema butonu
          const root=document.documentElement, btn=document.getElementById('themeBtn'), ico=document.getElementById('themeIcon'), txt=document.getElementById('themeText');
          const KEY='seridoviz.theme';
          function applyTheme(val){
            root.setAttribute('data-theme',val);
            if(val==='seridoviz-dark'){ ico.className='bi bi-moon'; txt.textContent='Koyu Tema'; }
            else { ico.className='bi bi-sun'; txt.textContent='Açık Tema'; }
            document.getElementById('themeColorMeta')?.setAttribute('content','@theme');
          }
          try{
            applyTheme(localStorage.getItem(KEY) || root.getAttribute('data-theme') || 'seridoviz-dark');
            btn?.addEventListener('click',()=>{
              const cur=root.getAttribute('data-theme')||'seridoviz-dark';
              const next=(cur==='seridoviz-dark')?'seridoviz-light':'seridoviz-dark';
              localStorage.setItem(KEY,next); applyTheme(next);
            });
          }catch{}
        })();
    </script>
</body>
</html>
