@model IEnumerable<SeriGold.DTO.ServiceItemDto>
@using System.Text.RegularExpressions
@using System.Text

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hizmetler";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a class="text-decoration-none" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
            <li class="breadcrumb-item active">Hizmetler</li>
        </ol>
    </nav>
}

@if (TempData["ok"] is string okMsg)
{
    <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@okMsg</div>
}

<div class="card card-glow">
    <div class="card-header d-flex flex-column flex-md-row gap-2 align-items-md-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grid-3x3-gap text-warning"></i>
            <strong>Hizmetler</strong>
            <span class="badge text-bg-secondary">@Model.Count()</span>
        </div>
        <div class="d-flex gap-2">
            <input id="q" class="form-control form-control-sm" placeholder="Ara: başlık, ikon veya içerik..." />
            <a class="btn btn-sm btn-warning" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Yeni</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover align-middle table-sm mb-0" id="tbl">
            <thead class="small text-secondary">
                <tr>
                    <th style="width:80px">Sıra</th>
                    <th>Başlık & Özet</th>
                    <th style="width:260px">İkon</th>
                    <th style="width:120px">Durum</th>
                    <th style="width:160px" class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model.OrderBy(m => m.DisplayOrder).ThenBy(m => m.Title))
                {
                    // HTML -> düz metin özet
                    var plain = Regex.Replace(x.Description ?? "", "<.*?>", string.Empty);
                    var shortText = plain.Length > 140 ? (plain.Substring(0, 140) + "…") : plain;

                    // Tam HTML’i güvenli şekilde attribute’ta taşı (Base64)
                    var desc64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(x.Description ?? ""));

                    <tr data-search="@($"{x.DisplayOrder} {x.Title} {x.Icon} {plain}".ToLowerInvariant())">
                        <td><span class="badge text-bg-dark border">@x.DisplayOrder</span></td>
                        <td>
                            <div class="fw-semibold d-flex align-items-center gap-2">
                                @x.Title
                                <button type="button"
                                        class="btn btn-xs btn-outline-light border-0 px-2 py-0"
                                        data-bs-toggle="tooltip" title="Detayları görüntüle"
                                        data-desc64="@desc64"
                                        data-title="@x.Title"
                                        onclick="showDescModal(this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <div class="text-secondary small text-truncate" style="max-width: 740px">@shortText</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="btn btn-sm btn-outline-secondary disabled">
                                    <i class="@x.Icon"></i>
                                </span>
                                <code class="small">@x.Icon</code>
                            </div>
                        </td>
                        <td>
                            @if (x.IsActive)
                            {
                                <span class="badge text-bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a class="btn btn-sm btn-outline-info" asp-action="Edit" asp-route-id="@x.Id" data-bs-toggle="tooltip" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form method="post" asp-action="Delete" asp-route-id="@x.Id" asp-antiforgery="true"
                                      onsubmit="return confirm('Silinsin mi?')">
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- HTML Önizleme Modal -->
<div class="modal fade" id="descModal" tabindex="-1" aria-labelledby="descModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content bg-body-tertiary">
            <div class="modal-header">
                <h5 class="modal-title" id="descModalLabel">Açıklama</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div id="descModalBody" class="prose"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Arama
            const q = document.getElementById('q');
            const rows = Array.from(document.querySelectorAll('#tbl tbody tr'));
            q?.addEventListener('input', function () {
                const t = (this.value || '').toLowerCase();
                rows.forEach(r => {
                    const hay = r.getAttribute('data-search') || r.innerText.toLowerCase();
                    r.style.display = hay.includes(t) ? '' : 'none';
                });
            });

            // Tooltip’ler
            const tList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tList.map(el => new bootstrap.Tooltip(el));
        })();

        // Modal tetikleyici: Base64’ten HTML’i çöz ve bas
        function showDescModal(btn) {
            try {
                const title = btn.getAttribute('data-title') || 'Açıklama';
                const b64 = btn.getAttribute('data-desc64') || '';
                const html = atob(b64);
                document.getElementById('descModalLabel').textContent = title;
                document.getElementById('descModalBody').innerHTML = html || '<span class="text-secondary">Boş içerik</span>';
                const m = new bootstrap.Modal(document.getElementById('descModal'));
                m.show();
            } catch (e) {
                console.error(e);
                alert('İçerik görüntülenemedi.');
            }
        }
    </script>
}
