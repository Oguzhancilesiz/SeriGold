@* Areas/Admin/Views/Shared/_AdminLayout.cshtml *@
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    string currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    string currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
}
<!doctype html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@(ViewData["Title"] != null ? $"Admin – {ViewData["Title"]}" : "Admin")</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --adm-bg: #0b0f13;
            --adm-nav: #0f141a;
            --adm-border: rgba(255,255,255,.08);
        }

        body {
            background: var(--adm-bg);
        }

        .navbar {
            background: var(--adm-nav);
        }

        .content-wrap {
            min-height: calc(100vh - 56px);
        }

        .brand-badge {
            font-weight: 600;
            letter-spacing: .3px;
        }

        .sidebar {
            border-right: 1px solid var(--adm-border);
        }

            .sidebar .list-group-item {
                background: transparent;
                border: 0;
                border-radius: 10px;
                color: #cbd5e1;
            }

                .sidebar .list-group-item.active {
                    background: #ffc107;
                    color: #111;
                }

                .sidebar .list-group-item:not(.active):hover {
                    background: rgba(255,255,255,.05);
                }

        .sidebar-sticky {
            position: sticky;
            top: 1rem;
            max-height: calc(100vh - 2rem);
            overflow-y: auto;
        }

        .page-heading {
            position: sticky;
            top: 0;
            z-index: 1020;
            background: linear-gradient(180deg, rgba(15,20,26,.98), rgba(15,20,26,.85));
            backdrop-filter: blur(6px);
            border-bottom: 1px solid var(--adm-border);
        }

        .adm-card {
            border: 1px solid var(--adm-border);
            border-radius: 14px;
        }

        .adm-section-title {
            font-size: .95rem;
            letter-spacing: .4px;
            color: #93a3b5;
            text-transform: uppercase;
        }

        .sticky-actions {
            position: sticky;
            top: 1rem;
            z-index: 1010;
        }

        .scrollspy-nav .nav-link {
            color: #a8b4c4;
        }

            .scrollspy-nav .nav-link.active {
                color: #111;
                background: #ffc107;
                border-radius: 999px;
            }

        .form-text {
            color: #8fa1b5;
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg border-bottom border-secondary">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Menüyü aç">
                <i class="bi bi-list"></i>
            </button>

            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-speedometer2 text-warning"></i>
                <span class="brand-badge">Seri Döviz • Admin</span>
            </a>

            <div class="ms-auto d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-warning" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Siteyi Aç
                </a>
                <a class="btn btn-sm btn-outline-danger" asp-area="Admin" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i> Çıkış
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid content-wrap">
        <div class="row g-0">
            <!-- Sidebar: LG ve üstü statik -->
            <aside class="col-lg-2 d-none d-lg-block sidebar">
                <div class="p-3 sidebar-sticky">
                    @await Html.PartialAsync("_AdminNav")
                </div>
            </aside>

            <!-- Sidebar: LG altı offcanvas -->
            <div class="offcanvas offcanvas-start bg-body-tertiary d-lg-none" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="adminSidebarLabel">Yönetim</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
                </div>
                <div class="offcanvas-body">
                    @await Html.PartialAsync("_AdminNav")
                </div>
            </div>

            <!-- Content -->
            <main class="col-lg-10">
                <div class="page-heading px-3 px-lg-4 py-3">
                    @RenderSection("Breadcrumb", required: false)
                    <h1 class="h5 m-0">@ViewData["Title"]</h1>
                </div>
                <div class="p-3 p-lg-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="border-top border-secondary py-3 small text-secondary">
        <div class="container-fluid d-flex justify-content-between">
            <span>© @DateTime.Now.Year Seri Döviz</span>
            <span>Admin Panel • Bootstrap 5</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
